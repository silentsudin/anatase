diff --git a/src/rapl.h b/src/rapl.h
new file mode 100644
index 000000000000..4c877cc3c039
--- /dev/null
+++ b/src/rapl.h
@@ -0,0 +1,113 @@
+#pragma once
+#ifndef MANGOHUD_RAPL_H
+#define MANGOHUD_RAPL_H
+
+#include <cerrno>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <spdlog/spdlog.h>
+#include "file_utils.h"
+#include "timing.hpp"
+
+// Reads a powercap (Intel/AMD RAPL) energy_uj counter and turns it into watts.
+// Handles counter wraparound via max_energy_range_uj.
+struct RaplCounter {
+    FILE* file = nullptr;
+    uint64_t max_range = 0;
+    uint64_t last_value = 0;
+    Clock::time_point last_time;
+    bool primed = false;
+
+    RaplCounter() = default;
+    RaplCounter(const RaplCounter&) = delete;
+    RaplCounter& operator=(const RaplCounter&) = delete;
+    ~RaplCounter() { close(); }
+
+    void close() {
+        if (file)
+            fclose(file);
+        file = nullptr;
+        primed = false;
+    }
+
+    bool open(const std::string& domain_path) {
+        close();
+        std::string energy = domain_path + "/energy_uj";
+        file = fopen(energy.c_str(), "r");
+        if (!file) {
+            if (errno == EACCES)
+                SPDLOG_WARN("RAPL: {} is not readable (root-only by default). "
+                            "Allow reading it with a udev rule to get power readings.", energy);
+            else
+                SPDLOG_DEBUG("RAPL: cannot open {}: {}", energy, strerror(errno));
+            return false;
+        }
+
+        std::string range = read_line(domain_path + "/max_energy_range_uj");
+        max_range = range.empty() ? 0 : strtoull(range.c_str(), nullptr, 10);
+        return true;
+    }
+
+    bool is_open() const { return file != nullptr; }
+
+    // Returns false when no reading is available. The first successful call only
+    // primes the counter and reports 0 W.
+    bool read(float& watts) {
+        if (!file)
+            return false;
+
+        rewind(file);
+        fflush(file);
+
+        uint64_t value = 0;
+        if (fscanf(file, "%" SCNu64, &value) != 1)
+            return false;
+
+        Clock::time_point now = Clock::now();
+        watts = 0.f;
+
+        if (primed) {
+            int64_t us = std::chrono::duration_cast<std::chrono::microseconds>(now - last_time).count();
+            uint64_t delta;
+            if (value >= last_value)
+                delta = value - last_value;
+            else if (max_range > last_value)
+                delta = max_range - last_value + value;
+            else
+                delta = 0;
+
+            if (us > 0)
+                watts = (float)((double)delta / (double)us);
+        }
+
+        last_value = value;
+        last_time = now;
+        primed = true;
+        return true;
+    }
+};
+
+// Finds the powercap domain with the given name ("package-0", "uncore", "core"...),
+// preferring the MSR based intel-rapl/amd-rapl zones over intel-rapl-mmio.
+static inline std::string find_rapl_domain(const std::string& domain_name) {
+    const std::string powercap = "/sys/class/powercap/";
+    std::string fallback;
+
+    for (auto& dir : ls(powercap.c_str())) {
+        std::string path = powercap + dir;
+        if (read_line(path + "/name") != domain_name)
+            continue;
+
+        if (dir.find("mmio") == std::string::npos)
+            return path;
+
+        if (fallback.empty())
+            fallback = path;
+    }
+
+    return fallback;
+}
+
+#endif // MANGOHUD_RAPL_H

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: silentsudin <25103587+silentsudin@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:03:12 +0100
Subject: gpu_fdinfo: support Intel integrated GPU power and memory

xe only registers hwmon for discrete GPUs, so integrated Intel GPUs
always reported 0 W and 0 GiB.

- Read GPU power from the RAPL "uncore" powercap domain when an xe/i915
  device has no hwmon power/energy sensor.
- Detect integrated memory (drm-resident-gtt / drm-resident-system0) on
  every update instead of only in the constructor, where the tracked fds
  may not have any allocations yet.
- Report system-wide GPU memory for xe integrated GPUs through
  DRM_XE_DEVICE_QUERY_MEM_REGIONS (sysmem region used/total) in
  sys_vram_used/memoryTotal, so the VRAM row shows real usage.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gpu_fdinfo.cpp | 128 +++++++++++++++++++++++++++++++++++++++++++++
 src/gpu_fdinfo.h   |  30 +++++------
 2 files changed, 143 insertions(+), 15 deletions(-)

diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index 0fdd99e83621..481c4a24a0c4 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -4,6 +4,13 @@
 #include "hud_elements.h"
 #endif
 
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#if __has_include(<drm/xe_drm.h>)
+#include <drm/xe_drm.h>
+#define HAVE_XE_DRM_H 1
+#endif
+
 namespace fs = ghc::filesystem;
 
 void GPU_fdinfo::find_fd()
@@ -145,6 +152,96 @@ uint64_t GPU_fdinfo::get_gpu_time_panfrost() {
     return total;
 }
 
+static bool fdinfo_has_value(
+    const std::vector<std::map<std::string, std::string>>& data, const std::string& key)
+{
+    for (auto& fd : data) {
+        auto it = fd.find(key);
+        if (it != fd.end() && !it->second.empty())
+            return true;
+    }
+
+    return false;
+}
+
+// Discrete Intel GPUs report vram (local0/vram0) in fdinfo, integrated ones only
+// system memory. Re-evaluated every update, because the fds tracked at startup
+// may not have any allocations yet.
+void GPU_fdinfo::update_memory_type()
+{
+    if (integrated_memory || fdinfo_data.empty())
+        return;
+
+    std::string sysmem_type;
+    if (module == "i915")
+        sysmem_type = "drm-resident-system0";
+    else if (module == "xe")
+        sysmem_type = "drm-resident-gtt";
+    else
+        return;
+
+    if (fdinfo_has_value(fdinfo_data, drm_memory_type) ||
+        !fdinfo_has_value(fdinfo_data, sysmem_type))
+        return;
+
+    SPDLOG_DEBUG(
+        "\"{}\" is not found, you probably have an integrated GPU. "
+        "Using \"{}\"", drm_memory_type, sysmem_type
+    );
+
+    drm_memory_type = sysmem_type;
+    integrated_memory = true;
+}
+
+// System-wide GPU memory in system RAM, as accounted by xe for all clients.
+bool GPU_fdinfo::get_xe_sysmem_usage(float& used, float& total)
+{
+#ifdef HAVE_XE_DRM_H
+    if (module != "xe")
+        return false;
+
+    if (xe_fd < 0) {
+        xe_fd = open(("/dev/dri/" + drm_node).c_str(), O_RDWR | O_CLOEXEC);
+        if (xe_fd < 0)
+            return false;
+    }
+
+    struct drm_xe_device_query query = {};
+    query.query = DRM_XE_DEVICE_QUERY_MEM_REGIONS;
+
+    if (ioctl(xe_fd, DRM_IOCTL_XE_DEVICE_QUERY, &query) || query.size == 0)
+        return false;
+
+    std::vector<uint8_t> buf(query.size);
+    query.data = reinterpret_cast<uintptr_t>(buf.data());
+
+    if (ioctl(xe_fd, DRM_IOCTL_XE_DEVICE_QUERY, &query))
+        return false;
+
+    auto regions = reinterpret_cast<struct drm_xe_query_mem_regions*>(buf.data());
+    for (uint32_t i = 0; i < regions->num_mem_regions; i++) {
+        auto& region = regions->mem_regions[i];
+
+        // A vram region means a discrete GPU, which is not handled here.
+        if (region.mem_class == DRM_XE_MEM_REGION_CLASS_VRAM)
+            return false;
+    }
